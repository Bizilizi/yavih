# environments
.venv/
venv/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# version file written by setuptools-scm at build / install time
src/yavih/_version.py

# yavih artefacts
runs/
results/
*.tmp
_stale/
*.tar
*.npy
*.log
# python -m yavih.headers / previews --html-only (the committed records are assets/header.src.sha256, assets/preview.src.json)
benchmarks/*/assets/*.html
benchmarks/*/assets/_work/

# editors / OS / agents
.DS_Store
.idea/
.vscode/
.claude/

# local maintainer notes inside a benchmark folder: never committed, so never in a folder's tree or a fetch
benchmarks/*/notes/
